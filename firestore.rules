rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Koleksi Kode Akses & Pendaftaran Guru SIPARTAN
    match /sipartan_access_codes/{document=**} {
      allow read, write: if true;
    }

    // 2. Koleksi Pengaturan Sistem, Kebijakan Unduhan, & Ruang Murid
    match /sipartan_settings/{document=**} {
      allow read, write: if true;
    }

    // 3. Koleksi Workspace Kerja & Perangkat Ajar Guru (Sinkronisasi Antar-Perangkat)
    match /sipartan_user_workspaces/{document=**} {
      allow read, write: if true;
    }

    // 4. Koleksi Ujian & Lembar Evaluasi Siswa
    match /sipartan_exams/{document=**} {
      allow read, write: if true;
    }

    // 5. Koleksi Hasil Kiriman Ujian Siswa (Exam Submissions)
    match /sipartan_exam_submissions/{document=**} {
      allow read, write: if true;
    }

    // 6. Koleksi Kamar Bahan Ajar & Materi Pembelajaran
    match /sipartan_learning_materials/{document=**} {
      allow read, write: if true;
    }

    // 7. Koleksi Data Siswa & Rapor
    match /sipartan_student_records/{document=**} {
      allow read, write: if true;
    }

    // Aturan Default / Fallback untuk seluruh koleksi dokumen SIPARTAN
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
